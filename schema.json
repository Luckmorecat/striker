{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "harness": {
      "type": "string",
      "enum": ["codex", "claude", "opencode", "pi"]
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^-\\s][^\\s]*$"
    },
    "model": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "reasoningEffort": {
      "type": "string",
      "enum": ["low", "medium", "high", "xhigh"]
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "taskSource": { "type": "string", "const": "striker-plan" }
  },
  "required": ["taskSource"],
  "additionalProperties": false,
  "title": "Striker project configuration"
}
