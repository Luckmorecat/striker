{
  "name": "@kisshot/striker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "plan.schema.json",
    "skills",
    "!dist/**/*.test.*",
    "!dist/testing"
  ],
  "bin": {
    "striker": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "zod": "^4.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node write-plan-schema.js",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
