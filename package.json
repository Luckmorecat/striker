{
  "name": "@useless_mob/striker",
  "version": "0.1.0",
  "description": "Task dispatcher for agent implementation plans",
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "cli",
    "task-runner",
    "workflow"
  ],
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "plan.schema.json",
    "schema.json",
    "skills",
    "!dist/**/*.test.*",
    "!dist/testing",
    "runtime",
    "docs/isolated-execution.md",
    "docs/derived-images.md",
    "docs/release-acceptance.md"
  ],
  "bin": {
    "striker": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plan.schema.json": "./plan.schema.json",
    "./schema.json": "./schema.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.85.1",
    "acpx": "0.13.1",
    "commander": "^15.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "zod": "^4.0.0"
  },
  "scripts": {
    "preview:progress": "tsc --project tsconfig.preview.json && node dist-preview/testing/progress-preview.js",
    "build": "node clean-dist.js && tsc --project tsconfig.build.json && node write-plan-schema.js",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "pnpm build && node validate-package.js",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:global-install": "node test-global-install.js",
    "typecheck": "tsc --noEmit",
    "test:docker": "node test-docker.js",
    "test:smoke": "node test-smoke.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
